# Copy this file to .env and adjust values. .env is gitignored.
# Variables already set in the shell take precedence over .env.

# Server
PORT=8080
UPLOAD_DIR=uploads
# Sessions are stored server-side and sent as an HttpOnly cookie, so there is no
# signing secret to configure. Set COOKIE_SECURE=true (the default) over HTTPS.
# Local http development needs false, because a Secure cookie is not sent over http.
COOKIE_SECURE=false
# Comma-separated addresses of proxies whose X-Forwarded-For is trusted for the
# client IP. Leave empty when the API is reached directly, so a client cannot
# spoof its IP and bypass rate limits.
TRUSTED_PROXIES=

# Database. DB_PASSWORD is required and must be a strong value.
# docker-compose.yml reads these too, so the app and the database stay in sync.
# After changing DB_PASSWORD on an existing database, run:
#   docker compose down -v && docker compose up -d
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=replace-me-with-a-strong-password
DB_NAME=cafe_review

# Admin user for `go run ./cmd/createadmin` (optional)
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=replace-me-with-a-strong-password
ADMIN_NAME=Admin
