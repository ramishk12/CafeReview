# Copy this file to .env and adjust values. .env is gitignored.
# Variables already set in the shell take precedence over .env.

# Server
PORT=8080
JWT_SECRET=change-me-to-a-long-random-string
UPLOAD_DIR=uploads

# Database (matches docker-compose.yml)
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=postgres
DB_NAME=cafe_review

# Admin user for `go run ./cmd/createadmin` (optional)
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=changeme123
ADMIN_NAME=Admin
